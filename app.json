{
  "expo": {
    "name": "Pixel Studios",
    "slug": "pixel-studios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pixelstudios",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.pixelstudios.app"
    },
    "android": {
      "package": "ng.pixelstudios.app",
      "adaptiveIcon": {
        "backgroundColor": "#07070D",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070D",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
