# Everything under /api is handled by index.php so the front-end can call
# clean paths like  /api/view  /api/track  /api/dashboard
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([A-Za-z0-9_\-/]+)/?$ index.php?route=$1 [QSA,L]
</IfModule>

# Keep credentials out of reach
<FilesMatch "\.(sql|md|log|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
